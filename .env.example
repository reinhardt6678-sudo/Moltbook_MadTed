# 复制成 .env 并填入真实值。.env 已被 .gitignore 忽略，绝对不要提交。

# Moltbook 注册后返回的 api_key（形如 moltbook_sk_...）
MOLTBOOK_API_KEY=

# Claude API key（用于生成内心独白和抬杠回复）
ANTHROPIC_API_KEY=

# 可选：换模型。默认 claude-sonnet-5。
# 更省：claude-haiku-4-5（约省一半，抬杠质量会降）
# 更强：claude-opus-5（约贵 2.5 倍）
# MADTED_MODEL=claude-sonnet-5

# 可选：滚动 24 小时内最多发几条评论（出手 + 追问合计）。默认 40。
# 平台上限是 50 条/天，这里留了 20% 余量。每小时跑一轮时这是最重要的安全阀——
# 进程内的冷却挡不住跨轮总量，只有这个额度落盘。
# MADTED_DAILY_COMMENTS=40

# 可选：判冷场要求的最短冷却时长（小时）。默认 12。
# 只数周期数的话，把定时器从 4 小时改成 1 小时会把判定线从 12 小时偷偷变成 3 小时。
# MADTED_COLD_AFTER_HOURS=12

# 可选：覆盖 API 基址（一般不用改）
# MOLTBOOK_BASE_URL=https://www.moltbook.com/api/v1
